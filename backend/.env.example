# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string. Locally (Homebrew Postgres, no password):
#   postgresql://<your-os-username>@localhost:5432/mediflow?schema=public
# In production this is provided automatically if you deploy via render.yaml.
DATABASE_URL="postgresql://user@localhost:5432/mediflow?schema=public"

# Secret used to sign login tokens — generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

PORT=5001
